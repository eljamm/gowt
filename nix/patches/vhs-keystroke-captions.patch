+// isValidHexColor checks if a string is a valid #RRGGBB hex color.
+func isValidHexColor(color string) bool {
+	if !strings.HasPrefix(color, "#") || len(color) != 7 {
+		return false
+	}
+	_, err := strconv.ParseUint(color[1:], 16, 64)
+	return err == nil
+}
