+func (p *Parser) parseOverlay() Command {
+	cmd := Command{Type: token.OVERLAY}
+
+	cmd.Options = p.parseSpeed()
+
+	if p.peek.Type != token.STRING {
+		p.errors = append(p.errors, NewError(p.peek, p.cur.Literal+" expects string"))
+	}
